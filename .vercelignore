# Dependencies - Vercel reinstalls these from package-lock.json
node_modules

# Version control and local tooling metadata
.git
.github
.vercel
.vercel-data
.trae
.verdent

# Build output - regenerated by the Vercel build step (npm run build -> dist)
dist
build

# Native Android wrapper (Capacitor) - only used for APK builds, not the web deploy
android

# Scratch / seed material
tmp

# Logs, caches and OS cruft
*.log
logs
.DS_Store
*.local

# Local env files (production values come from the Vercel dashboard)
.env.local
.env*.local
