rules_version = '2';

// Deploy in Firebase Console → Firestore → Rules, or: firebase deploy --only firestore:rules
//
// The app writes userSubmissions from the browser without Firebase Auth
// (login uses Supabase). Rules must allow client create/read on these collections.

service cloud.firestore {
  match /databases/{database}/documents {
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if true;
    }

    match /userSubmissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /kidsSubmissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /quranSubmissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /nasheedRequests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /views/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /votes/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /adAudio/{adAudioId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
